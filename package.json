{
  "name": "slice",
  "version": "1.0.4",
  "private": true,
  "description": "Local desktop DICOM viewer with W/L and MPR",
  "author": "Slice",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dmitrii-Salikhov/Slice.git"
  },
  "homepage": "https://github.com/Dmitrii-Salikhov/Slice",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RUN_AS_NODE= VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:debug": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RUN_AS_NODE= SLICE_DEVTOOLS=1 VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dist:win": "npm run build && electron-builder --win --x64 --dir",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@cornerstonejs/codec-charls": "^1.2.3",
    "@cornerstonejs/codec-openjpeg": "^1.3.0",
    "@zip.js/zip.js": "^2.8.34",
    "dcmjs": "^0.43.1",
    "dcmjs-dimse": "^0.3.3",
    "dicom-parser": "^1.8.21",
    "jpeg-js": "^0.4.4",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.slice.dicomviewer",
    "productName": "Slice",
    "copyright": "Copyright © Slice",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "Icon.ico",
      "CHANGELOG.md"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "asar": true,
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    },
    "fileAssociations": [
      {
        "ext": "dcm",
        "name": "DICOM Image",
        "description": "DICOM medical image",
        "mimeType": "application/dicom",
        "role": "Viewer",
        "icon": "dcm.ico"
      },
      {
        "ext": "dicom",
        "name": "DICOM Image",
        "description": "DICOM medical image",
        "mimeType": "application/dicom",
        "role": "Viewer",
        "icon": "dcm.ico"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Dmitrii-Salikhov",
        "repo": "Slice"
      }
    ]
  }
}
